<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">

    <xacro:arg name="left_initial_positions_file"
            default="$(find dual_arm_panda_moveit_config)/config/left_initial_positions.yaml"/>
    <xacro:arg name="right_initial_positions_file"
            default="$(find dual_arm_panda_moveit_config)/config/right_initial_positions.yaml"/>
    <xacro:arg name="ros2_control_hardware_type" default="mock_components" />
    <xacro:arg name="use_sensone_left" default="false" />
    <xacro:arg name="alter_finger_left" default="false" />
    <xacro:arg name="use_sensone_right" default="false" />
    <xacro:arg name="alter_finger_right" default="false" />

    <!-- Xacro imports -->
    <xacro:include filename="panda_arm_macro.xacro" />
    <xacro:include filename="panda_arm_sensone_macro.xacro" />
    <xacro:include filename="panda_arm_alter_finger_macro.xacro" />

    <!-- Root link -->
    <link name="world"/>

    <!-- box shaped table as base for the 2 Pandas -->
    <link name="base">
        <visual>
        <origin xyz="0.09 0 -0.525" rpy="0 0 0" />
        <geometry>
            <box size="0.8 1.6 1" />
        </geometry>
        <material name="White">
            <color rgba="1.0 1.0 1.0 1.0" />
        </material>
        </visual>
        <collision>
        <origin xyz="0.09 0 -0.525" rpy="0 0 0" />
        <geometry>
            <box size="0.8 1.6 1" />
        </geometry>
        </collision>
        <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="10.0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.001" iyy="0.0" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="base_to_world" type="fixed">
        <parent link="world"/>
        <child link="base"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <!-- Left arm -->
    <!-- left arm base -->
    <link name="left_base">
        <visual>
        <origin xyz="-0.04 -0.281 -0.0125" rpy="0 0 0" />
        <geometry>
            <box size="0.25 0.25 0.025" />
        </geometry>
        <material name="White">
            <color rgba="1.0 1.0 1.0 1.0" />
        </material>
        </visual>
        <!-- <collision>
        <origin xyz="0.09 0 0.5" rpy="0 0 0" />
        <geometry>
            <box size="0.8 1.6 1" />
        </geometry>
        </collision> -->
        <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="10.0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.001" iyy="0.0" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="left_base_to_world" type="fixed">
        <parent link="base"/>
        <child link="left_base"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <xacro:if value="$(arg use_sensone_left)">
        <xacro:panda_arm_sensone
            name="left_panda"
            prefix="left_"
            parent="base"
            initial_positions_file="$(arg left_initial_positions_file)"
            ros2_control_hardware_type="$(arg ros2_control_hardware_type)">
            <origin xyz="0 -0.281 0.0" rpy="0 0 0" />
        </xacro:panda_arm_sensone>
    </xacro:if>
    <xacro:unless value="$(arg use_sensone_left)">
        <xacro:if value="$(arg alter_finger_left)">
            <xacro:panda_arm_alter_finger
                name="left_panda"
                prefix="left_"
                parent="base"
                initial_positions_file="$(arg left_initial_positions_file)"
                ros2_control_hardware_type="$(arg ros2_control_hardware_type)">
                <origin xyz="0 -0.281 0.0" rpy="0 0 0" />
            </xacro:panda_arm_alter_finger>
        </xacro:if>
        <xacro:unless value="$(arg alter_finger_left)">
        <xacro:panda_arm
            name="left_panda"
            prefix="left_"
            parent="base"
            initial_positions_file="$(arg left_initial_positions_file)"
            ros2_control_hardware_type="$(arg ros2_control_hardware_type)">
            <origin xyz="0 -0.281 0.0" rpy="0 0 0" />
        </xacro:panda_arm>
        </xacro:unless>
    </xacro:unless>

    <!-- Right arm -->
    <!-- right arm base -->
    <link name="right_base">
        <visual>
        <origin xyz="-0.04 0.281 -0.0125" rpy="0 0 0" />
        <geometry>
            <box size="0.25 0.25 0.025" />
        </geometry>
        <material name="White">
            <color rgba="1.0 1.0 1.0 1.0" />
        </material>
        </visual>
        <!-- <collision>
        <origin xyz="-0.04 0.281 -0.0125" rpy="0 0 0" />
        <geometry>
            <box size="0.8 1.6 1" />
        </geometry>
        </collision> -->
        <inertial>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <mass value="10.0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.001" iyy="0.0" iyz="0.0" izz="0.001"/>
        </inertial>
    </link>

    <joint name="right_base_to_world" type="fixed">
        <parent link="base"/>
        <child link="right_base"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <xacro:if value="$(arg use_sensone_right)">
        <xacro:panda_arm_sensone
            name="right_panda"
            prefix="right_"
            parent="base"
            initial_positions_file="$(arg right_initial_positions_file)"
            ros2_control_hardware_type="$(arg ros2_control_hardware_type)">
            <origin xyz="0 0.281 0.0" rpy="0 0 0" />
        </xacro:panda_arm_sensone>
    </xacro:if>
    <xacro:unless value="$(arg use_sensone_right)"> 
        <xacro:if value="$(arg alter_finger_right)">
            <xacro:panda_arm_alter_finger
                name="right_panda"
                prefix="right_"
                parent="base"
                initial_positions_file="$(arg right_initial_positions_file)"
                ros2_control_hardware_type="$(arg ros2_control_hardware_type)">
                <origin xyz="0 0.281 0.0" rpy="0 0 0" />
            </xacro:panda_arm_alter_finger>
        </xacro:if>
        <xacro:unless value="$(arg alter_finger_right)">
        <xacro:panda_arm
            name="right_panda"
            prefix="right_"
            parent="base"
            initial_positions_file="$(arg right_initial_positions_file)"
            ros2_control_hardware_type="$(arg ros2_control_hardware_type)">
            <origin xyz="0 0.281 0.0" rpy="0 0 0" />
        </xacro:panda_arm>
        </xacro:unless>
    </xacro:unless>
</robot>
